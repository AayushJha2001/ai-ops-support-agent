# Copy to .env and fill in. Every provider below has a free tier - no credit card needed.

# --- LLM -------------------------------------------------------------------------
# Primary provider: gemini | groq | ollama | fake   (fake = offline, deterministic, no key)
LLM_PROVIDER=gemini
# Tried in order if the primary errors / is rate limited
LLM_FALLBACKS=groq

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order if the primary Gemini model is overloaded (503) or rate limited (429)
GEMINI_BACKUP_MODELS=gemini-3.6-flash,gemini-3.8-flash
# minimal | low | medium | high (blank = model default). Lower = faster.
GEMINI_THINKING_LEVEL=low

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local models: https://ollama.com  (then: ollama pull qwen3:8b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: list prices (USD / 1M tokens) to estimate paid-tier cost. Free tier = 0.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# --- Database ----------------------------------------------------------------------
DATABASE_URL=postgresql://ops:ops@localhost:55432/ops_agent
READONLY_DB_USER=agent_readonly
READONLY_DB_PASSWORD=agent_readonly_pw

# --- Retrieval -----------------------------------------------------------------------
# fastembed = local BAAI/bge-small-en-v1.5 (free, ~130MB download once); hash = tests only
EMBEDDING_PROVIDER=fastembed

# --- Safety --------------------------------------------------------------------------
# risk_based: refunds + risky ticket changes need approval; all_writes: every write needs approval
APPROVAL_MODE=risk_based
REFUND_MAX_USD=500
MAX_AGENT_STEPS=10

# Optional LangSmith tracing (free developer tier)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=ops-support-agent

# Public demo hosting (see README "Free hosted demo")
# CORS_ORIGINS=https://your-console.vercel.app
# DEMO_RATE_LIMIT_PER_HOUR=30
# DEMO_RESET_ON_START=true
